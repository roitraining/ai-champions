      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-push.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
